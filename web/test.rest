###############################################################################
# ALERTS
###############################################################################

### Get all alerts
GET {{baseUrl}}/alerts
Authorization: Bearer {{accessToken}}


### Get active alerts
GET {{baseUrl}}/alerts/active
Authorization: Bearer {{accessToken}}


### Get alert history
GET {{baseUrl}}/alerts/history
Authorization: Bearer {{accessToken}}


### Get specific alert
GET {{baseUrl}}/alerts/{{alertId}}
Authorization: Bearer {{accessToken}}


### Acknowledge alert
POST {{baseUrl}}/alerts/{{alertId}}/acknowledge
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "note": "Alert reviewed by administrator."
}


### Resolve alert
POST {{baseUrl}}/alerts/{{alertId}}/resolve
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "note": "Environmental conditions returned to normal."
}


